# Ambiente local não exige gateway. Em ambientes publicados, configure APP_ENV e GATEWAY_TOKEN.
APP_ENV=local
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Integração corporativa usada pelo gpt_bradesco.py.
BRADESCO_AMBIENTE=dev
BRADESCO_TEXT_MODEL=
BRADESCO_IDENTIFICADOR=
BRADESCO_SENHA=
BRADESCO_AUTHORIZATION_TOKEN=
BRADESCO_CA_BUNDLE=
BRADESCO_TIMEOUT_SECONDS=600

# Opcionais: somente se a infraestrutura corporativa exigir URLs explícitas.
BRADESCO_TEXT_URL=
BRADESCO_IDENTITY_URL=
BRADESCO_QA_URL=
BRADESCO_QA_WORKFLOW_CODE=CD_WRFL_QA_778_LEITURA_SENTENCA_PIAUI_AAJR_SYNC

# Limites do workspace documental.
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=12
MAX_TOTAL_UPLOAD_BYTES=83886080
MAX_PDF_PAGES=2500
WORKSPACE_TTL_MINUTES=120
MAX_WORKSPACES_IN_MEMORY=30
BRADESCO_PROMPT_MAX_CHARS=52000
BRADESCO_ANALYSIS_MAX_TOKENS=9000
MAX_ANALYSIS_CHUNKS=24

# Demandas BJN: persistência privada e diretório de anexos.
# Em produção, usar volume persistente cifrado e autenticação do gateway corporativo.
BJN_DATABASE_PATH=.runtime/bjn/demandas.sqlite3
BJN_UPLOAD_DIRECTORY=.runtime/bjn/uploads
# Lista permitida de advogados (e-mails corporativos), separada por vírgula.
BJN_ALLOWED_LAWYERS=

# Somente APP_ENV=local: habilita equipe fictícia de advogados na distribuição BJN.
BJN_DEMO_LAWYERS=true

# BJN · fluxo de demandas (não inserir credenciais neste arquivo exemplo)
# Em ambiente local a chave HMAC é criada automaticamente em .runtime/bjn.
BJN_DOCUMENT_HASH_KEY=
# Notificações por e-mail são opcionais; em branco mantém o envio pendente.
BJN_NOTIFICATION_SMTP_HOST=
BJN_NOTIFICATION_SMTP_PORT=587
BJN_NOTIFICATION_SENDER=
BJN_NOTIFICATION_USERNAME=
BJN_NOTIFICATION_PASSWORD=
